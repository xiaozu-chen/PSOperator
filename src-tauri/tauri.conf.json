{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSOperator",
  "version": "0.2.0",
  "identifier": "dev.psoperator.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PSOperator",
        "width": 1040,
        "height": 700,
        "minWidth": 560,
        "minHeight": 360,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1f1e1d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
