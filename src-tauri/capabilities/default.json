{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the PSOperator main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://localhost" },
        { "url": "http://localhost:*" },
        { "url": "https://localhost" },
        { "url": "https://localhost:*" },
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://127.0.0.1" },
        { "url": "https://127.0.0.1:*" },
        { "url": "http://[::1]" },
        { "url": "http://[::1]:*" },
        { "url": "https://[::1]" },
        { "url": "https://[::1]:*" }
      ]
    }
  ]
}
